# Copy this file to ".env" and fill in your Firebase project's web app config.
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup.
# These are safe to expose in client code - real protection comes from
# firestore.rules, not from hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Draft-mark photo reading does NOT use a .env variable - its API key lives
# server-side only, in Firebase Secret Manager, set via:
#   firebase functions:secrets:set GEMINI_API_KEY
# See functions/index.js for full setup steps. This is intentional: an
# OpenAI/Gemini key put here would be baked into the public browser bundle
# and readable by anyone, unlike the Firebase values above.